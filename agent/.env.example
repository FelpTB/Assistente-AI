# Copie para .env (uso local) ou cadastre como Variables no Railway.
# NUNCA faça commit do .env.

# Segredo do webhook — gere uma string aleatória longa
WEBHOOK_TOKEN=

# Evolution API
EVOLUTION_URL=https://evolution-api-production-8f8e.up.railway.app
EVOLUTION_AUTH_KEY=
EVOLUTION_INSTANCE=Felipe-Assistente

# ID do seu grupo solo (descubra enviando /ativar no grupo). Vários: separe por vírgula.
ALLOWED_CHAT_JIDS=

# Claude API
CLAUDE_API_KEY=
# Só se a chave não for de um workspace específico (erro "anthropic-workspace-id")
CLAUDE_WORKSPACE_ID=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Notion (integração interna com acesso à página "Assistente AI")
TOKEN_NOTION=
NOTION_TASKS_DATA_SOURCE_ID=5072380e-9871-4bb0-8eed-695dca78ed8b

# Google (OAuth da conta felipe@abcadvise.com.br)
GOOGLE_ID_CLIENT=
GOOGLE_SECRET_KEY=
GOOGLE_REFRESH_TOKEN=
GOOGLE_EXPENSES_SHEET_ID=1ATjK3sX3y8_IbgA38cqs1GU3seBus5VAI2441vuzTUI
GOOGLE_CALENDAR_ID=primary

# Dashboard (opcionais)
DASHBOARD_EMAILS=felipe@abcadvise.com.br
PUBLIC_URL=
DASHBOARD_SESSION_SECRET=

# Projeto Busca Fornecedor — aba Trabalho (opcionais; sem elas o painel avisa o que falta)
BF_SUPABASE_URL=https://hccolkrnyrxcbxuuajwq.supabase.co
BF_SUPABASE_KEY=
BF_SUPABASE_SCHEMA=busca_fornecedor
BF_SITE_URL=
N8N_URL=
N8N_API_KEY=

# Servidor MCP (/mcp) para o Claude Code. Gere um valor longo e aleatório; sem ele o MCP fica desligado.
# Na sua máquina, defina o mesmo valor em ASSISTENTE_MCP_TOKEN (usado pelo .mcp.json do projeto).
# MCP_TOKEN=

# Capex Radar: o dashboard lê pelo MCP do app. Padrão: o endereço publicado; token só quando o MCP exigir.
# CAPEX_RADAR_URL=https://capex-radar-buscafornecedor.up.railway.app
# CAPEX_RADAR_TOKEN=

# Chamados do Busca Fornecedor: e-mail de um usuário que está em busca_fornecedor.app_admins.
# O servidor abre a sessão desse admin sem senha (link gerado com a service_role).
# BF_ADMIN_EMAIL=

# Planilha "Ficha de Treino" (esfera Academia). Padrão: a planilha criada na pasta Assistente AI.
# GOOGLE_TREINO_SHEET_ID=

# Planilha mensal de ponto (data table do n8n; usa N8N_URL e N8N_API_KEY acima).
# No dia 1, o agente prepara o mês anterior e pede aprovação no grupo antes de enviar.
# Envio por Gmail: o GOOGLE_REFRESH_TOKEN precisa do escopo https://www.googleapis.com/auth/gmail.send
PONTO_EMAIL=waltagan@abcadvise.com.br
PONTO_FUNCIONARIO=Felipe
# PONTO_TABELA=          # nome ou ID da data table (padrão: a que tem "ponto" e o nome do funcionário, ex. "Ponto Felipe")
# PONTO_HORA_AVISO=9
